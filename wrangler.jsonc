// Hébergement du jeu sur Cloudflare (Workers, fichiers statiques).
// La commande de build copie le moteur à côté de la page : web/moteur/.
{
  "name": "thaayam",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "not_found_handling": "single-page-application"
  }
}
