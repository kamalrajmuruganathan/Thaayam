{
  "expo": {
    "name": "Thaayam",
    "slug": "thaayam",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#04070b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamal.thaayam"
    },
    "android": {
      "package": "com.kamal.thaayam",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#05080c"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      ["expo-notifications", { "color": "#5fd4ff" }]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
